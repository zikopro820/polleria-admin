rules_version = '2';
// =========================================================
// POLLERÍA EL POLLÓN — Reglas de seguridad de Firestore
// Pega TODO este archivo en Firebase → Firestore Database → Reglas → Publicar.
// Los correos deben ser los MISMOS de firebase-config.js (equipo) del panel.
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function equipo() {
      return request.auth != null && request.auth.token.email in [
        'admin@elpollon.pe', 'caja@elpollon.pe', 'cocina@elpollon.pe', 'reparto@elpollon.pe'
      ];
    }
    function admin() {
      return request.auth != null && request.auth.token.email in ['admin@elpollon.pe'];
    }
    function d() { return request.resource.data; }
    function soloCambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    // ---------- Carta pública (la web y la app la leen) ----------
    match /ajustes/{id}    { allow read: if true; allow create, delete: if admin();
                             allow update: if admin() || (equipo() && soloCambia(['estadoManual'])); }   // caja puede abrir/cerrar
    match /categorias/{id} { allow read: if true; allow write: if admin(); }
    match /zonas/{id}      { allow read: if true; allow write: if admin(); }
    match /productos/{id}  { allow read: if true; allow create, delete: if admin();
                             allow update: if admin() || (equipo() && soloCambia(['agotado'])); }       // caja marca agotados

    // ---------- Pedidos ----------
    match /pedidos/{id} {
      allow get: if true;                    // el cliente sigue su pedido con su código
      allow list, update, delete: if equipo();
      allow create: if equipo() || (
        d().keys().hasOnly(['codigo', 'items', 'subtotal', 'envio', 'total', 'entrega', 'zona', 'direccion', 'referencia', 'ubic', 'nombre', 'celular', 'doc',
          'comprobante', 'nota', 'pago', 'banco', 'monto', 'operacion', 'montoLeido', 'coincide', 'fechaOk', 'pagaCon', 'estado', 'origen', 'creado'])
        && d().codigo == id && d().origen == 'web' && d().entrega in ['delivery', 'recojo'] && d().estado in ['por-validar', 'nuevo']
        && d().items is list && d().items.size() > 0 && d().items.size() <= 60
        && d().total is number && d().total > 0 && d().total < 5000
        && d().nombre is string && d().nombre.size() <= 80 && d().celular is string && d().celular.size() <= 15
        && (d().estado == 'nuevo') == (d().pago == 'Efectivo'));
    }
    // Captura del pago Yape / Plin (solo el equipo la ve)
    match /capturas/{id} {
      allow read, update, delete: if equipo();
      allow create: if equipo() || (
        d().keys().hasOnly(['pedido', 'captura']) && d().pedido == id
        && existsAfter(/databases/$(database)/documents/pedidos/$(id))
        && d().captura is string && d().captura.size() < 900000);
    }
    match /movimientos/{id} { allow read, write: if equipo(); }
  }
}
